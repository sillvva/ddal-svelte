# Alternatively, you can use the `op` command to pull the environment variables from a 1Password environment.
# This is useful for local development without having the secrets stored on disk. Replace the environment-id
# in the package.json script with your own environment id. The 1Password CLI should be version 2.41.0 or higher.

# Auth: BetterAuth
AUTH_SECRET=

# Auth: Google Provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth: Discord Provider
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Log levels: none, info, debug, error
LOG_LEVEL=debug