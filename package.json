{
	"name": "ddal-svelte",
	"version": "0.0.2",
	"private": true,
	"scripts": {
		"prepare": "svelte-kit sync || echo ''",
		"start:supabase": "./start-supabase.sh",
		"clean:circular": "ds src --exclude-types",
		"clean:install": "rm -rf node_modules pnpm-lock.yaml && pnpm install",
		"clean:dev": "rm -rf .svelte-kit && pnpm dev",
		"dev": "pnpm start:supabase && vite dev",
		"build": "pnpm env-check && vite build",
		"preview": "vite preview",
		"env-check": "node -v && pnpm -v && vite -v",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint \"src/**/*.{ts,svelte}\" --max-warnings=0",
		"format": "prettier --plugin-search-dir . --write .",
		"db:generate": "drizzle-kit generate"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify-json/logos": "^1.2.16",
		"@iconify-json/material-symbols": "^1.2.95",
		"@iconify-json/mdi": "^1.2.3",
		"@iconify/tailwind4": "^1.2.3",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/js-cookie": "^3.0.6",
		"@types/node": "^24.13.6",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"autoprefixer": "^10.6.1",
		"daisyui": "5.7.50",
		"drizzle-kit": "1.0.0-rc.5",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vite-plugin-devtools-json": "^1.1.2"
	},
	"type": "module",
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.7.10",
		"@better-auth/passkey": "^1.7.10",
		"@humanspeak/svelte-markdown": "^2.1.3",
		"@internationalized/date": "^3.12.4",
		"@resvg/resvg-js": "^2.6.2",
		"@sillvva/search": "^1.0.3",
		"@sillvva/utils": "^0.9.0",
		"@standard-schema/spec": "^1.1.0",
		"@svelteuidev/composables": "^0.15.7",
		"@types/regexp.escape": "^2.0.0",
		"better-auth": "^1.7.10",
		"bits-ui": "^2.19.5",
		"chalk": "^6.0.1",
		"drizzle-orm": "1.0.0-rc.5",
		"effect": "^4.0.5",
		"js-cookie": "^3.0.8",
		"postgres": "^3.4.9",
		"regexp.escape": "^2.0.1",
		"satori": "^0.60.0",
		"sharp": "^0.35.5",
		"shiki": "^4.5.0",
		"svelte-autosize": "^1.1.5",
		"svelte-breadcrumbs": "^2.0.1",
		"svelte-contextify": "^1.0.4",
		"svelte-sonner": "^1.2.1",
		"sveltekit-search-params": "4.0.1",
		"uuid": "^14.0.3",
		"valibot": "1.5.0"
	},
	"engines": {
		"node": ">=24.0"
	},
	"packageManager": "pnpm@11.8.0",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
