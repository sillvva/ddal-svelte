{
	"name": "ddal-svelte",
	"version": "0.0.2",
	"private": true,
	"scripts": {
		"prepare": "svelte-kit sync || echo ''",
		"start:supabase": "./start-supabase.sh",
		"clean:circular": "ds src --exclude-types",
		"clean:install": "rm -rf node_modules pnpm-lock.yaml && pnpm install",
		"clean:dev": "rm -rf .svelte-kit && pnpm dev",
		"dev": "pnpm start:supabase && vite dev",
		"op:dev": "pnpm start:supabase && FORCE_COLOR=1 op run --environment 4iuxdmr3wcxhjj7m7gd4qen46u -- vite dev",
		"dev:process": "lsof -i :5173",
		"dev:kill": "kill -9 $(lsof -t -i :5173)",
		"build": "pnpm env-check && vite build",
		"preview": "vite preview",
		"env-check": "node -v && pnpm -v && vite -v",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint \"src/**/*.{ts,svelte}\" --max-warnings=0",
		"format": "prettier --plugin-search-dir . --write .",
		"test": "pnpm test:unit && pnpm test:e2e",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "pnpm exec playwright install chromium && playwright test",
		"test:e2e:cleanup": "node --experimental-strip-types e2e/cleanup.ts",
		"test:e2e:guard": "node --experimental-strip-types e2e/guard-check.ts",
		"op:test:e2e": "FORCE_COLOR=1 op run --environment 4iuxdmr3wcxhjj7m7gd4qen46u -- env E2E_ALLOW_LOCAL=1 pnpm test:e2e",
		"op:test:e2e:cleanup": "FORCE_COLOR=1 op run --environment 4iuxdmr3wcxhjj7m7gd4qen46u -- env E2E_ALLOW_LOCAL=1 pnpm test:e2e:cleanup",
		"op:test": "pnpm test:unit && pnpm op:test:e2e",
		"op:db:diff": "FORCE_COLOR=1 op run --environment 4iuxdmr3wcxhjj7m7gd4qen46u -- sh -c 'supabase db diff --db-url \"$REMOTE_DB_URL\"'",
		"op:db:push": "FORCE_COLOR=1 op run --environment 4iuxdmr3wcxhjj7m7gd4qen46u -- sh -c 'supabase db push --db-url \"$REMOTE_DB_URL\"'",
		"op:db:dump": "FORCE_COLOR=1 op run --environment 4iuxdmr3wcxhjj7m7gd4qen46u -- sh -c 'supabase db dump --data-only -f supabase/seed.sql --db-url \"$REMOTE_DB_URL\"'",
		"op:db:backup": "FORCE_COLOR=1 op run --environment 4iuxdmr3wcxhjj7m7gd4qen46u -- sh -c 'dir=supabase/backups/$(date +%Y%m%d-%H%M%S) && mkdir -p \"$dir\" && supabase db dump --db-url \"$REMOTE_DB_URL\" --role-only -f \"$dir/roles.sql\" && supabase db dump --db-url \"$REMOTE_DB_URL\" -f \"$dir/schema.sql\" && supabase db dump --db-url \"$REMOTE_DB_URL\" --data-only --use-copy -f \"$dir/data.sql\"'",
		"db:push:local": "supabase db push --local",
		"db:pull:local": "supabase db pull --local",
		"db:reset:local": "./check-supabase-ports.sh && supabase db reset --local"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify-json/logos": "^1.2.19",
		"@iconify-json/material-symbols": "^1.2.97",
		"@iconify-json/mdi": "^1.2.3",
		"@iconify/tailwind4": "^1.2.3",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/postcss": "^4.3.5",
		"@tailwindcss/vite": "^4.3.5",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/js-cookie": "^3.0.6",
		"@types/node": "^26.6.6",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"autoprefixer": "^10.6.2",
		"daisyui": "5.7.50",
		"devalue": "^5.9.4",
		"drizzle-kit": "1.0.0-rc.5",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"tslib": "^2.9.1",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vite-plugin-devtools-json": "^1.1.2",
		"vitest": "^5.1.0"
	},
	"type": "module",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1164.0",
		"@aws-sdk/s3-request-presigner": "^3.1164.0",
		"@better-auth/drizzle-adapter": "^1.7.18",
		"@better-auth/passkey": "^1.7.18",
		"@humanspeak/svelte-markdown": "^2.2.0",
		"@internationalized/date": "^3.12.4",
		"@resvg/resvg-js": "^2.6.2",
		"@sillvva/search": "^1.0.3",
		"@sillvva/utils": "^0.9.2",
		"@standard-schema/spec": "^1.1.0",
		"@svelteuidev/composables": "^0.15.7",
		"@types/regexp.escape": "^2.0.0",
		"better-auth": "^1.7.18",
		"bits-ui": "^2.20.6",
		"chalk": "^6.0.1",
		"drizzle-orm": "1.0.0-rc.5",
		"effect": "^4.1.2",
		"js-cookie": "^3.0.8",
		"postgres": "^4.1.0",
		"regexp.escape": "^2.0.1",
		"satori": "^0.63.2",
		"sharp": "^0.35.5",
		"shiki": "^4.6.0",
		"svelte-autosize": "^1.1.5",
		"svelte-sonner": "^1.2.3",
		"sveltekit-search-params": "4.0.1",
		"uqr": "^0.1.3",
		"uuid": "^14.0.3",
		"valibot": "1.5.0"
	},
	"engines": {
		"node": ">=26.0"
	},
	"packageManager": "pnpm@11.8.0",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
