{
	"name": "ddal-svelte",
	"version": "0.0.2",
	"private": true,
	"scripts": {
		"prepare": "svelte-kit sync || echo ''",
		"clean:circular": "ds src --exclude-types",
		"clean:install": "rm -rf node_modules pnpm-lock.yaml && pnpm install",
		"clean:dev": "rm -rf .svelte-kit && pnpm dev",
		"op:run": "FORCE_COLOR=1 ddal-run --",
		"dev": "pnpm db:local:up && vite dev",
		"op:dev": "pnpm db:local:up && pnpm op:run vite dev",
		"dev:process": "lsof -i :5173",
		"dev:kill": "kill -9 $(lsof -t -i :5173)",
		"build": "pnpm env-check && vite build",
		"op:build": "pnpm op:run vite build",
		"preview": "vite preview",
		"env-check": "node -v && pnpm -v && vite -v",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint \"src/**/*.{ts,svelte}\" --max-warnings=0",
		"format": "prettier --plugin-search-dir . --write .",
		"test": "pnpm test:unit && pnpm test:e2e",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "pnpm exec playwright install chromium && playwright test",
		"test:e2e:cleanup": "node --experimental-strip-types e2e/cleanup.ts",
		"test:e2e:guard": "node --experimental-strip-types e2e/guard-check.ts",
		"op:test:e2e": "pnpm op:run env E2E_ALLOW_LOCAL=1 pnpm test:e2e",
		"op:test:e2e:cleanup": "pnpm op:run env E2E_ALLOW_LOCAL=1 pnpm test:e2e:cleanup",
		"op:test": "pnpm test:unit && pnpm op:test:e2e",
		"op:worktree:setup": "./scripts/worktree-setup.sh",
		"op:db:diff": "pnpm op:run ./scripts/db-local.sh diff-remote",
		"op:db:push": "pnpm op:run ./scripts/db-push.sh --yes",
		"op:db:push:dry": "pnpm op:run ./scripts/db-push.sh --dry-run",
		"op:db:dump": "pnpm op:run ./scripts/db-dump.sh seed",
		"op:db:backup": "pnpm op:run ./scripts/db-dump.sh backup",
		"op:r2:clean:dev": "pnpm op:run node --experimental-strip-types scripts/r2-clean-dev.ts",
		"db:local:up": "./scripts/db-local.sh up",
		"db:local:down": "./scripts/db-local.sh down",
		"db:local:reset": "./scripts/db-local.sh reset",
		"op:db:local:reset": "pnpm db:local:reset && pnpm op:r2:clean:dev",
		"db:local:migrate": "./scripts/db-local.sh migrate",
		"db:local:restore": "./scripts/db-local.sh restore",
		"op:db:local:restore": "pnpm db:local:restore && pnpm op:r2:clean:dev",
		"db:local:psql": "./scripts/db-local.sh psql",
		"db:local:nuke": "./scripts/db-local.sh nuke",
		"db:migration:new": "supabase migration new",
		"db:local:diff": "./scripts/db-local.sh diff",
		"db:local:pull": "./scripts/db-local.sh diff -f remote_schema"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify-json/logos": "^1.2.20",
		"@iconify-json/material-symbols": "^1.2.101",
		"@iconify-json/mdi": "^1.2.3",
		"@iconify/tailwind4": "^1.2.3",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/postcss": "^4.3.5",
		"@tailwindcss/vite": "^4.3.5",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/js-cookie": "^3.0.6",
		"@types/node": "^26.6.6",
		"@typescript-eslint/eslint-plugin": "^8.73.0",
		"@typescript-eslint/parser": "^8.73.0",
		"autoprefixer": "^10.6.2",
		"daisyui": "5.8.1",
		"devalue": "^6.0.3",
		"drizzle-kit": "1.0.0-rc.5",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"tslib": "^2.9.1",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vite-plugin-devtools-json": "^1.1.2",
		"vitest": "^5.1.1"
	},
	"type": "module",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1172.0",
		"@aws-sdk/s3-request-presigner": "^3.1172.0",
		"@better-auth/drizzle-adapter": "^1.7.26",
		"@better-auth/passkey": "^1.7.26",
		"@humanspeak/svelte-markdown": "^2.3.0",
		"@internationalized/date": "^3.12.4",
		"@resvg/resvg-js": "^2.6.2",
		"@sillvva/search": "^1.0.3",
		"@sillvva/utils": "^0.9.2",
		"@standard-schema/spec": "^1.1.0",
		"@svelteuidev/composables": "^0.15.7",
		"@types/regexp.escape": "^2.0.0",
		"better-auth": "^1.7.26",
		"bits-ui": "^2.21.0",
		"chalk": "^6.0.1",
		"drizzle-orm": "1.0.0-rc.5",
		"effect": "^4.1.4",
		"js-cookie": "^3.0.8",
		"postgres": "^4.1.1",
		"regexp.escape": "^2.0.1",
		"satori": "^0.63.2",
		"sharp": "^0.35.5",
		"shiki": "^4.6.0",
		"svelte-autosize": "^1.1.5",
		"svelte-sonner": "^1.2.3",
		"sveltekit-search-params": "4.0.2",
		"uqr": "^0.1.3",
		"uuid": "^14.0.3",
		"valibot": "1.5.0"
	},
	"engines": {
		"node": ">=26.0"
	},
	"packageManager": "pnpm@11.8.0",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
