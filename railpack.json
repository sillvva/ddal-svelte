{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "24"
  },
  "steps": {
    "install": {
      "commands": [
        "pnpm install --frozen-lockfile"
      ]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        "pnpm run build"
      ]
    }
  },
  "deploy": {
    "startCommand": "node build/index.js",
    "variables": {
      "HOST": "0.0.0.0",
      "PORT": "4173"
    },
    "inputs": [
      {
        "step": "build",
        "include": ["."]
      }
    ]
  }
}
